{
  "name": "agent-bus",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "bin": {
    "agent-bus": "./src/bin.ts"
  },
  "scripts": {
    "prepare": "./scripts/prepare-effect.sh",
    "typecheck": "bun --no-env-file scripts/typecheck.ts",
    "lint": "biome check .",
    "lint:effect": "biome lint --config-path=biome.effect.json .",
    "format": "biome check --write .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run test && bun run check:docs && bun run check:stewards",
    "check:docs": "bun scripts/check-docs.ts",
    "sync:stewards": "bun scripts/sync-stewards.ts",
    "check:stewards": "bun scripts/sync-stewards.ts --check",
    "qualify:fluree": "bun scripts/qualify-fluree.ts",
    "qualify:release": "bun --no-env-file scripts/qualify-release.ts",
    "rehearse:release": "bun --no-env-file scripts/rehearse-release.ts",
    "qualify:private-web": "bun --no-env-file scripts/qualify-private-web.ts",
    "qualify:toolchain": "bun --no-env-file scripts/qualify-toolchain.ts",
    "install:launch-agents": "./scripts/install-launch-agents.sh",
    "viewer:build": "bun --no-env-file scripts/build-viewer.ts",
    "viewer": "bun --no-env-file viewer/server/main.ts",
    "test:viewer:unit": "bun --no-env-file test test/viewer-public.test.ts test/viewer-conversations.test.ts test/viewer-markdown-policy.test.ts test/viewer-observation-resource.test.ts test/viewer-investigation.test.ts test/viewer-investigation-contract.test.ts test/viewer-pinned-traversal.test.ts test/viewer-pinned-reference.test.ts test/viewer-pinned-labels.test.ts test/viewer-reading-unit.test.ts test/viewer-announcements.test.ts",
    "test:browser": "bun --no-env-file scripts/local-tool.ts browser",
    "test:browser:live": "bun --no-env-file scripts/local-tool.ts browser-live",
    "test:browser:investigation": "bun --no-env-file scripts/local-tool.ts browser-investigation",
    "test:browser:pinned": "bun --no-env-file scripts/local-tool.ts browser-pinned",
    "test:storybook": "bun --no-env-file scripts/local-tool.ts storybook-plays",
    "storybook": "bun --no-env-file scripts/local-tool.ts storybook dev --host 127.0.0.1 --port 6006 --exact-port --ci --disable-telemetry",
    "storybook:build": "bun --no-env-file scripts/local-tool.ts storybook build --output-dir dist/storybook --disable-telemetry",
    "nx": "bun --no-env-file scripts/local-tool.ts nx",
    "qualify:viewer-cache": "bun --no-env-file scripts/qualify-viewer-cache.ts",
    "test:orientation:unit": "bun --no-env-file test test/orientation-model.test.ts test/orientation-intent.test.ts test/orientation-coherence.test.ts test/orientation-partial.test.ts",
    "check:fast": "bun --no-env-file scripts/local-tool.ts nx run-many -t typecheck lint test-viewer-unit test-orientation-unit --parallel=1"
  },
  "nx": {
    "includedScripts": []
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.2",
    "@orpc/client": "1.16.1",
    "@orpc/server": "1.16.1",
    "effect": "4.1.2",
    "lucide-react": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sparqljs": "3.7.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@browserbasehq/stagehand": "4.3.0",
    "@catenarycloud/linteffect": "0.1.0",
    "@effect/tsgo": "0.63.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@storybook/react-vite": "10.6.3",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sparqljs": "3.1.12",
    "nx": "24.0.2",
    "storybook": "10.6.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "7.3.1"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.1.2"
  }
}
