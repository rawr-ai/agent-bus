{
  "name": "agent-bus",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "bin": {
    "agent-bus": "./src/bin.ts"
  },
  "scripts": {
    "prepare": "./scripts/prepare-effect.sh",
    "typecheck": "tsc && tsc -p viewer/tsconfig.server.json && tsc -p viewer/tsconfig.browser.json && tsc -p tsconfig.storybook.json && tsc -p tsconfig.browser-tests.json",
    "lint": "biome check .",
    "lint:effect": "biome lint --config-path=biome.effect.json .",
    "format": "biome check --write .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run test && bun run check:docs",
    "check:docs": "bun scripts/check-docs.ts",
    "qualify:fluree": "bun scripts/qualify-fluree.ts",
    "install:launch-agents": "./scripts/install-launch-agents.sh",
    "viewer:build": "bun --no-env-file scripts/build-viewer.ts",
    "viewer": "bun --no-env-file viewer/server/main.ts",
    "test:viewer:unit": "bun --no-env-file test test/viewer-public.test.ts test/viewer-conversations.test.ts test/viewer-markdown-policy.test.ts test/viewer-observation-resource.test.ts",
    "test:browser": "bun --no-env-file scripts/local-tool.ts browser",
    "test:browser:live": "bun --no-env-file scripts/local-tool.ts browser-live",
    "test:storybook": "bun --no-env-file scripts/local-tool.ts storybook-plays",
    "storybook": "bun --no-env-file scripts/local-tool.ts storybook dev --host 127.0.0.1 --port 6006 --exact-port --ci --disable-telemetry",
    "storybook:build": "bun --no-env-file scripts/local-tool.ts storybook build --output-dir dist/storybook --disable-telemetry",
    "nx": "bun --no-env-file scripts/local-tool.ts nx",
    "qualify:viewer-cache": "bun --no-env-file scripts/qualify-viewer-cache.ts",
    "check:fast": "bun --no-env-file scripts/local-tool.ts nx run-many -t typecheck lint test-viewer-unit --parallel=1"
  },
  "nx": {
    "includedScripts": []
  },
  "patchedDependencies": {
    "@catenarycloud/linteffect@0.0.6": "patches/@catenarycloud%2Flinteffect@0.0.6.patch"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.6",
    "@orpc/client": "1.14.8",
    "@orpc/server": "1.14.8",
    "effect": "4.0.6",
    "lucide-react": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@browserbasehq/stagehand": "4.3.0",
    "@catenarycloud/linteffect": "0.0.6",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@storybook/react-vite": "10.6.3",
    "@types/bun": "1.3.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "nx": "24.0.2",
    "storybook": "10.6.3",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.6"
  }
}
