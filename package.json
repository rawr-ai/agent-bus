{
  "name": "agent-bus",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "bin": {
    "agent-bus": "./src/bin.ts"
  },
  "scripts": {
    "prepare": "./scripts/prepare-effect.sh",
    "typecheck": "tsc",
    "lint": "biome check .",
    "lint:effect": "biome lint --config-path=biome.effect.json .",
    "format": "biome check --write .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run test",
    "qualify:fluree": "bun scripts/qualify-fluree.ts",
    "install:launch-agents": "./scripts/install-launch-agents.sh"
  },
  "patchedDependencies": {
    "@catenarycloud/linteffect@0.0.6": "patches/@catenarycloud%2Flinteffect@0.0.6.patch"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.6",
    "effect": "4.0.6",
    "sparqljs": "3.7.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@catenarycloud/linteffect": "0.0.6",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/bun": "1.3.14",
    "@types/sparqljs": "3.1.12",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.6"
  }
}
