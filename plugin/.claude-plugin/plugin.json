{
  "name": "agent-bus",
  "description": "Wakes a Claude Code session when agent-bus mail arrives for an address it owns",
  "author": {
    "name": "rawr-ai"
  },
  "repository": "https://github.com/rawr-ai/agent-bus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$HOME/.local/bin:$HOME/.bun/bin:$PATH\" exec \"$HOME/.local/bin/agent-bus\" claude-wake",
            "asyncRewake": true,
            "timeout": 2592000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$HOME/.local/bin:$HOME/.bun/bin:$PATH\" exec \"$HOME/.local/bin/agent-bus\" claude-wake",
            "asyncRewake": true,
            "timeout": 2592000
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$HOME/.local/bin:$HOME/.bun/bin:$PATH\" exec \"$HOME/.local/bin/agent-bus\" claude-wake",
            "asyncRewake": true,
            "timeout": 2592000
          }
        ]
      }
    ]
  }
}
