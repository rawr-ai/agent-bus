{
  "name": "agent-bus",
  "description": "Restores held bus addresses and the route to current guidance after compaction",
  "author": { "name": "rawr-ai" },
  "repository": "https://github.com/rawr-ai/agent-bus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$HOME/.local/bin:$HOME/.bun/bin:$PATH\" exec \"$HOME/.local/bin/agent-bus\" compact-context --runtime codex",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
